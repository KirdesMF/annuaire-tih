{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "annuaire-tih-dev",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2025-09-24",
  "main": "app/server.ts",
  "observability": {
    "enabled": true
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "7e2870d7d80047fdbf42bfc362bbfe0b"
    }
  ],
  "env": {
    "production": {
      "name": "annuaire-tih",
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "5073119ffaa4492e868e15e8205d3629"
        }
      ]
    }
  }
}
